@model List<Author>
@{

    ViewData["Title"] = "Authors";
}

<h1>Authors</h1>
<a asp-action="Create" class="btn btn-success">Add Author</a>
<table class="table mt-3">
    <thead>
        <tr>
            <td>FullName</td>
            <td>Biography</td>
            <td>Actions</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.FullName</td>
                <td>@author.Biography?.Substring(0,100)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-outline-info">Edit</a>
                    <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-outline-info">Delete</a>
                </td>

            </tr>
        }
    </tbody>
</table>