@model List<Author>
@{

    ViewData["Title"] = "Authors";
}

<h1>Authors</h1>
<a asp-action="Create" class="btn btn-success">Add Author</a>
<table class="table mt-3">
    <thead>
        <tr>
            <td>FullName</td>
            <td>Biography</td>
            <td>Actions</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr style="width:300px;">
                <td>@author.FullName</td>
                <td>
                @(author.Biography!=null? author.Biography.Substring(0,Math.Min(author.Biography.Length,100)):"Biography is null")

                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-outline-info">Edit</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@author.Id" />
                        <button type="submit"  class="btn btn-danger d-inline-block">Delete</button>
                   </form>
                </td>

            </tr>
        }
    </tbody>
</table>