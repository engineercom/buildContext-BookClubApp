@model Category
@{

    ViewData["Title"] = "Edit";
}
<h1>Edit Category</h1>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
   
    <button type="submit" class="btn btn-success">Update Category</button>
</form>