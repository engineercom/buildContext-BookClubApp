@model List<Category>
@{

    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>
<a asp-action="Create" class="btn btn-success">Add Category</a>
<table class="table mt-3">
    <thead>
        <tr>
            <td>Category</td>
       
            <td>Actions</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr style="width:300px;">
                <td>@category.Name</td>
              
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-outline-info">Edit</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@category.Id" />
                        <button type="submit" class="btn btn-danger d-inline-block">Delete</button>
                    </form>
                </td>

            </tr>
        }
    </tbody>
</table>