@model List<Book>
@{
    ViewData["Title"] = "Books";
}
<h1>Book List</h1>
<a asp-action="Create" class="btn btn-success">Add Book</a>
<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Book</th>
            <th>Author</th>
            <th>Categories</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author.FullName</td>
                <td>
                    @if (book.Categories!=null&& book.Categories.Any())
                    {
                       foreach (var category in book.Categories)
                        {
                            <span class="badge bg-secondary">@category.Name</span>
                        } 
                    }

                </td>
                <td>
                    <a asp-action="Edit" class="btn  btn-sm btn-outline-info" asp-route-id="@book.Id">Edit</a>
                    <a asp-action="Delete" class="btn  btn-sm  btn-outline-danger" asp-route-id="@book.Id">Delete</a>
                </td>
               
            </tr>
        }
    </tbody>
</table>