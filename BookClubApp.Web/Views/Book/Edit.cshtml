@using BookClubApp.Web.ViewModels
@model BookEditViewModel
@{
    ViewData["Title"] = "Edit Book";
}

<h1>Edit</h1>

<form method="post">
    <input type="hidden" asp-for="Id"/>
    <div class="mb-3">
        <label class="form-label" asp-for="Title"></label>
        <input class="form-control" asp-for="Title" />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Description"></label>
        <input class="form-control" asp-for="Description" />
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="AuthorId">Authors</label>
        <select class="form-select" asp-items="ViewBag.Authors" asp-for="AuthorId">

            <option>--Select Author--</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Categories</label>
        @foreach (var category in ViewBag.Categories)
        {
            <div class="form-check">
                <input type="checkbox" class="form-check-input"
                       name="SelectedCategoryIds"
                       value="@category.Value"
                       id="category_@category.Value" 
                       @(category.Selected? "checked" : "")/>
                <label class="form-check-label" for="category_@category.Value">@category.Text</label>
            </div>
        }
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>