@model Book
@{

    ViewData["Title"] = "Detail";
}

<div class="container mt-3">
    <h3>Book:@Model.Title</h3>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <p><strong>Description:</strong>@(Model.Description ?? "Açıklama yok")</p>
           
            <p>
                <strong>PublishedDate:</strong>@Model.PublishedDate.ToShortDateString()
            </p>
           
            <p><strong>Author:</strong>@(Model.Author?.FullName ?? "Yazar yok")</p>
           
            <p><strong>Categories:</strong>
            @foreach (var category in Model.Categories)
            {
                <span class="badge bg-secondary me-1">@category.Name</span>
            }
            </p>
         
            <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-primary">Return List</a>
            </div>
        </div>
    </div>
</div>